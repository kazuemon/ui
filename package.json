{
  "name": "@kazuemon/ui",
  "version": "0.1.1",
  "description": "Just another attempt at creating my dream React UI library.",
  "keywords": [
    "react",
    "tailwindcss",
    "ui",
    "components"
  ],
  "homepage": "https://ui.k6n.jp",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kazuemon/ui/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazuemon/ui.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tailwind.css": "./src/styles/tailwind.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./fonts-ja.css": "./src/styles/ibm-plex-sans-jp.css"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./tailwind.css": "./dist/tailwind.css",
      "./fonts.css": "./dist/fonts.css",
      "./fonts-ja.css": "./dist/fonts-ja.css",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o ./docs",
    "build": "tsdown && node scripts/build-css.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "prepack": "pnpm build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fonts": "node scripts/generate-fonts.mjs",
    "docs:dev": "pnpm --filter @kazuemon/docs dev",
    "docs:build": "pnpm --filter @kazuemon/docs build",
    "check:principles": "node design/tools/check-principles.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@daypicker/react": "^10.0.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/mulish": "^5.3.0",
    "maska": "^3.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "temporal-polyfill": "^1.0.5"
  },
  "peerDependencies": {
    "@fontsource/ibm-plex-sans-jp": "^5.3.0",
    "@phosphor-icons/react": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "@phosphor-icons/react": {
      "optional": true
    },
    "@fontsource/ibm-plex-sans-jp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-jp": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shikijs/transformers": "^4.4.3",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.4.3",
    "storybook": "^10.6.0",
    "storybook-addon-pseudo-states": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
