{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/styles/globals.css",
    "functions": ["tv"]
  },
  "ignorePatterns": ["src/styles/ibm-plex-sans-jp.css", "CHANGELOG.md"]
}
